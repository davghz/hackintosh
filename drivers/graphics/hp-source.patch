+    }
+}
+
+static void hpCursorStartCapture() {
+    if (gHpCursorTimer) return;
+    gHpCursorTimer = thread_call_allocate(hpCursorSnapshot, nullptr);
+    if (gHpCursorTimer) {
+        uint64_t deadline;
+        clock_interval_to_deadline(15000, kMillisecondScale, &deadline);
+        thread_call_enter_delayed(gHpCursorTimer, deadline);
+    } else {
+        SYSLOG("ngreen", "HP-CURSOR capture unavailable; cursor adjustment disabled");
+    }
+}
