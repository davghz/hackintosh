+        root->setProperty("hp-sync-waited", static_cast<uint32_t>(gHpSyncWaited), 32);
+        root->setProperty("hp-sync-refused", static_cast<uint32_t>(gHpSyncRefused), 32);
+        root->setProperty("hp-sync-timeouts", static_cast<uint32_t>(gHpSyncTimeouts), 32);
+        root->setProperty("hp-sync-stopped", static_cast<uint32_t>(gHpSyncStopped), 32);
