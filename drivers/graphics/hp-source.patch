+void hpSyncResolveIOAF(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+    gHpSyncTestEvent = patcher.solveSymbol(index, "__ZN24IOAccelEventMachineFast29testEventEP12IOAccelEvent", address, size);
+    if (!gHpSyncTestEvent) patcher.clearError();
+    gHpSyncStorage = patcher.solveSymbol(index, "__ZN16IOAccelResource218getStorageResourceEv", address, size);
+    if (!gHpSyncStorage) patcher.clearError();
+    gHpSyncIOAF = HPSyncSignatures::match(gHpSyncTestEvent, address, size, HPSyncSignatures::TestEvent) &&
+        HPSyncSignatures::match(gHpSyncStorage, address, size, HPSyncSignatures::StorageResource);
+    SYSLOG("ngreen", "HP-SYNC IOAF exact helper signatures: %s", gHpSyncIOAF ? "matched" : "rejected");
