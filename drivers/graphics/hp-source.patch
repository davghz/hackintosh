+    for (uint64_t page = start & ~0xFFFULL;; page += 4096) {
+        if (!reinterpret_cast<uint32_t (*)(void *, uint64_t)>(gPmapFindPhys)(map, page)) return false;
+        if (page == last) return true;
+    }
