+        gHpFenceQualified && gHpFenceMemoryQualified && readable;
+    const HPFence::Range output = HPFence::adjusted(qualified, layout, index, input, pitch, tile);
+    gHpFenceOutputSize = output.size;
+    if (output.size == input.size) {
+        OSIncrementAtomic(&gHpFenceRefused);
+        return original(fence, allocator, index, range, pitch, tile);
+    }
