+        root->setProperty("hp-fence-calls", static_cast<uint32_t>(gHpFenceCalls), 32);
+        root->setProperty("hp-fence-matched", static_cast<uint32_t>(gHpFenceMatched), 32);
+        root->setProperty("hp-fence-applied", static_cast<uint32_t>(gHpFenceApplied), 32);
+        root->setProperty("hp-fence-refused", static_cast<uint32_t>(gHpFenceRefused), 32);
+        root->setProperty("hp-fence-native-failed", static_cast<uint32_t>(gHpFenceNativeFailed), 32);
+        root->setProperty("hp-fence-input-start", gHpFenceStart, 64);
