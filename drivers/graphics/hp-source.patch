+template<typename T> static bool hpSyncRead(const void *object, size_t offset, T &out) {
+    const uint64_t base = reinterpret_cast<uint64_t>(object);
+    if (base > UINT64_MAX - offset) return false;
+    const void *source = reinterpret_cast<const void *>(base + offset);
+    if (!hpSyncMapped(source, sizeof(T))) return false;
+    memcpy(&out, source, sizeof(T));
+    return true;
