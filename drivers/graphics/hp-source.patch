+        root->setProperty("hp-linear-width", gHpLinearWidth, 32);
+        root->setProperty("hp-linear-mapped-pages", gHpLinearPages, 32);
+        root->setProperty("hp-linear-image-offset", gHpLinearOffset, 64);
+    }
+    if (captureCursor) SYSLOG("ngreen", "HP-CURSOR sample=%u seen=%u adjusted=%u input=%08x output=%08x pipe=%08x arb=%08x control=%08x base=%08x plane=%08x",
+        gHpCursorSamples, static_cast<uint32_t>(gHpCursorSeen), static_cast<uint32_t>(gHpCursorChanged),
