+static bool hpSyncMapped(const void *pointer, size_t bytes) {
+    const uint64_t start = reinterpret_cast<uint64_t>(pointer);
+    if (!HPSync::range(start, bytes) || !gPmapFindPhys || !gKernelPmap) return false;
+    void *map = *reinterpret_cast<void **>(gKernelPmap);
+    if (!map) return false;
