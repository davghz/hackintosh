+static uint32_t hpCursorFilter(unsigned long reg, uint32_t value) {
+    auto *ng = NGreen::callback;
+    if (reg != HPCursor::ControlA || !ng || !ng->hpProfileVerified ||
+        ng->mmioLength() < 0x70184 || !gHpCursorTimer)
+        return value;
+    const uint32_t arb = ng->readReg32(HPCursor::ArbControlA);
+    // 1.0.9: Display 13 cursor slots; HP 1.0.8 captured ARB=0x2a0f and CURCTL=0x27.
+    // Preserve the passing synchronization correction and every unrelated register bit.
+    const uint32_t output = HPCursor::filter(true, reg, value, arb);
+    // Saturating diagnostic counters; not used for hardware decisions.
+    if (gHpCursorSeen < 1000000) OSIncrementAtomic(&gHpCursorSeen);
+    if (output != value && gHpCursorChanged < 1000000) OSIncrementAtomic(&gHpCursorChanged);
+    gHpCursorInput = value;
+    gHpCursorOutput = output;
+    gHpCursorArb = arb;
+    return output;
+}
