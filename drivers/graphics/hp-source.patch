+    const bool readable = hpSyncRead(controller, 0xde4, layout.reserved) &&
+        hpSyncRead(controller, 0xdc0, layout.cursorStart) &&
+        hpSyncRead(controller, 0xdc8, layout.cursorBytes) &&
